# In .env kopieren und ausfüllen. .env ist gitignored und wird nie committet.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Lokales Modell mit LM Studio (Server gestartet, Modell geladen). Provider-Beispiel in evals/promptfooconfig.yaml.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# promptfoo ruft für Python-Grader den Befehl "python" auf. Auf macOS/Linux ohne aktiviertes venv gibt es nur "python3":
# PROMPTFOO_PYTHON=python3
